from google import genai
from google.genai import types
import json
import os

API_KEY=""

MODEL="gemini-3.5-flash-lite"
MEMORY_FILE="chat_memory.json"
history=[ ]

if os.path.exists(MEMORY_FILE):
    try:
        with open(MEMORY_FILE , "r") as file:
            saved_history=json.load(file)
            for items in saved_history:
                history.append(
                    types.content(
                        role=item["role"],
                        parts=[
                            types.part(
                                text=item["text"]
                                )
                            ]
                        )
                    )
                    
    except Exceptional:
            history=[ ]
            
def save_memory():
    history=chat.get_history
    data=[ ]
    for message in history:
        if not message.parts:
            continue
        text=message.parts[0].text
        if text is None:
            continue
        data.append(
            {
                "role":message.role,
                "text":text
                }
            )
        with open(MEMORY_FILE , "w") as file:
            json.dump(data,file, indent=4)
            
def clear_memory():
    global chat
    if os.path.exists(MEMORY_FILE):
        os.remove(MEMORY_FILE)
        print("MEGAN: Memory cleared successfully")
            

# 1. CONNECT TO GEMINI
client = genai.Client(api_key=API_KEY ) # REPLACE THIS

# 2. CREATE MEGAN WITH MEMORY
chat = client.chats.create(
    model=MODEL,
    history=history,
    config=types.GenerateContentConfig(
        system_instruction="You are a friendly AI chatbot named MEGAN:(Multi-Expert Generative Assistant Network) . Answer briefly and directly. Usually use 1-8 sentences.",
        max_output_tokens=120,
        temperature=0.7
    )
)

